# Each folder below these that holds .benchmark files becomes one regression job.
REGRESSION_BENCHMARK_FOLDERS=benchmark/vss
# At most 4, the cores of ubuntu-latest.
REGRESSION_MICRO_N_THREADS=4
# The sizes for the label extended-regression-tests; benchmark/vss/sift1m.benchmark.in has the default ones.
# Must be a multiple of 2,048.
REGRESSION_MICRO_VSS_ROW_GROUP_SIZE_EXTENDED=16384
# At most 1,000,000.
REGRESSION_MICRO_VSS_SIFT1M_ROWS_EXTENDED=491520
