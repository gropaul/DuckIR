# Each folder below these that holds .benchmark files becomes one regression job.
# Several folders are separated by spaces, e.g. "benchmark/vss/create benchmark/vss/search".
REGRESSION_BENCHMARK_FOLDERS=benchmark/vss
# The benchmark arguments for the label extended-regression-tests, per suite below benchmark/; without it, the
# benchmarks use their defaults. vss: row_group_size a multiple of 2,048, rows at most 1,000,000.
REGRESSION_EXTENDED_ARGUMENTS_VSS="rows=491520 row_group_size=16384"
# At most 4, the cores of ubuntu-latest.
REGRESSION_MICRO_N_THREADS=4
