# name: benchmark/vss/sync_insert.benchmark.in
# description: Sync after inserting the last 60% of the first rows SIFT1M vectors (benchmark/vss/config.benchmark.in) into an indexed table of the first 40%: the insert fills the open row group (appended to its mirror) and adds new row groups (built)
# group: [vss]

name Sync DUCKIR_VSS ${QUANTIZATION} after insert
group vss

require core_functions

require parquet

require duckir

include benchmark/vss/config.benchmark.in

load
ATTACH '${BENCHMARK_DIR}/vss_sync_insert_${QUANTIZATION}.db' AS vss (ROW_GROUP_SIZE ${row_group_size});
USE vss;
SET checkpoint_threshold = '10GB';
CREATE OR REPLACE TABLE base AS SELECT id, emb::FLOAT[128] AS emb FROM read_parquet('benchmark/data/sift1m_base.parquet') WHERE id < ${rows};
CREATE OR REPLACE TABLE t AS FROM base WHERE id < ${rows} * 2 // 5;
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = '${QUANTIZATION}', seed = 0);

run
INSERT INTO t FROM base WHERE id >= ${rows} * 2 // 5;
CALL duckir_vss_sync_index('idx');

cleanup
CREATE OR REPLACE TABLE t AS FROM base WHERE id < ${rows} * 2 // 5;
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = '${QUANTIZATION}', seed = 0);
