# name: benchmark/vss/search/search.benchmark.in
# description: Top-10 searches for 1,000 SIFT1M test vectors in one LATERAL join, on an index over the first rows SIFT1M vectors
# group: [vss]

name Search DUCKIR_VSS ${QUANTIZATION}

require duckir

include benchmark/vss/sift1m.benchmark.in

cache sift1m_search.duckdb

load
CREATE TABLE base AS SELECT idx AS id, emb::FLOAT[128] AS emb FROM 'hf://datasets/open-vdb/sift-128-euclidean/train/train-00001-of-00001.parquet';
CREATE TABLE queries AS SELECT idx AS id, emb::FLOAT[128] AS emb FROM 'hf://datasets/open-vdb/sift-128-euclidean/test/test-00001-of-00001.parquet' WHERE idx < 1000;
ATTACH '${BENCHMARK_DIR}/vss_search_${QUANTIZATION}.db' AS vss (ROW_GROUP_SIZE ${row_group_size});
USE vss;
SET checkpoint_threshold = '10GB';
CREATE OR REPLACE TABLE t AS FROM sift1m_search.base WHERE id < ${rows};
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = '${QUANTIZATION}', seed = 0);

reload
ATTACH '${BENCHMARK_DIR}/vss_search_${QUANTIZATION}.db' AS vss (ROW_GROUP_SIZE ${row_group_size});
USE vss;
SET checkpoint_threshold = '10GB';
CREATE OR REPLACE TABLE t AS FROM sift1m_search.base WHERE id < ${rows};
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = '${QUANTIZATION}', seed = 0);

run
SELECT q.id, s.id FROM sift1m_search.queries q, LATERAL (SELECT id FROM t ORDER BY array_distance(t.emb, q.emb) LIMIT 10) s;
