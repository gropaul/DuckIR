# name: benchmark/vss/insert/insert.benchmark.in
# description: Sync after inserting the last 60% of the first rows SIFT1M vectors into an indexed table of the first 40%: the insert fills the open row group (appended to its mirror) and adds new row groups (built)
# group: [vss]

name Sync DUCKIR_VSS ${QUANTIZATION} after insert

require duckir

include benchmark/vss/sift1m.benchmark.in

cache sift1m.duckdb

load
CREATE TABLE base AS SELECT idx AS id, emb::FLOAT[128] AS emb FROM 'hf://datasets/open-vdb/sift-128-euclidean/train/train-00001-of-00001.parquet';
ATTACH '${BENCHMARK_DIR}/vss_insert_${QUANTIZATION}.db' AS vss (ROW_GROUP_SIZE ${row_group_size});
USE vss;
SET checkpoint_threshold = '10GB';
CREATE OR REPLACE TABLE t AS FROM sift1m.base WHERE id < ${rows} * 2 // 5;
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = '${QUANTIZATION}', seed = 0);

reload
ATTACH '${BENCHMARK_DIR}/vss_insert_${QUANTIZATION}.db' AS vss (ROW_GROUP_SIZE ${row_group_size});
USE vss;
SET checkpoint_threshold = '10GB';
CREATE OR REPLACE TABLE t AS FROM sift1m.base WHERE id < ${rows} * 2 // 5;
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = '${QUANTIZATION}', seed = 0);

run
INSERT INTO t FROM sift1m.base WHERE id >= ${rows} * 2 // 5 AND id < ${rows};
CALL duckir_vss_sync_index('idx');

cleanup
CREATE OR REPLACE TABLE t AS FROM sift1m.base WHERE id < ${rows} * 2 // 5;
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = '${QUANTIZATION}', seed = 0);
