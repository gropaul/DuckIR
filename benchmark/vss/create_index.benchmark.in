# name: benchmark/vss/create_index.benchmark.in
# description: CREATE INDEX on the first ROWS SIFT1M vectors (benchmark/vss/config.benchmark.in)
# group: [vss]

name Create DUCKIR_VSS ${QUANTIZATION}
group vss

require parquet

require duckir

include benchmark/vss/config.benchmark.in

load
ATTACH '${BENCHMARK_DIR}/vss_create_index_${QUANTIZATION}.db' AS vss (ROW_GROUP_SIZE ${ROW_GROUP_SIZE});
USE vss;
SET checkpoint_threshold = '10GB';
CREATE OR REPLACE TABLE t AS SELECT id, emb::FLOAT[128] AS emb FROM read_parquet('benchmark/data/sift1m_base.parquet') WHERE id < ${ROWS};

run
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = '${QUANTIZATION}', seed = 0);

cleanup
DROP INDEX idx;
