# name: benchmark/vss/search.benchmark.in
# description: 1,000 sequential top-10 searches with the SIFT1M test vectors on an index over the first rows SIFT1M vectors (benchmark/vss/config.benchmark.in)
# group: [vss]

name Search DUCKIR_VSS ${QUANTIZATION}
group vss

require core_functions

require parquet

require duckir

include benchmark/data/config.benchmark.in

load
ATTACH '${BENCHMARK_DIR}/vss_search_${QUANTIZATION}.db' AS vss (ROW_GROUP_SIZE ${row_group_size});
USE vss;
SET checkpoint_threshold = '10GB';
CREATE OR REPLACE TABLE t AS SELECT id, emb::FLOAT[128] AS emb FROM read_parquet('benchmark/data/sift1m_base.parquet') WHERE id < ${rows};
CREATE OR REPLACE TABLE q AS SELECT qid, vec::FLOAT[128] AS vec FROM read_parquet('benchmark/data/sift1m_queries.parquet');
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = '${QUANTIZATION}', seed = 0);
SET VARIABLE q0 = (SELECT vec FROM q WHERE qid = 0);
SET VARIABLE q1 = (SELECT vec FROM q WHERE qid = 1);
SET VARIABLE q2 = (SELECT vec FROM q WHERE qid = 2);
